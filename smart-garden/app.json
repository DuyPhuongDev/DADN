{
  "expo": {
    "name": "Smart Garden",
    "slug": "smart-garden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/home_gardening_logo.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.expo.smartgarden"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.expo.smartgarden",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "newArchEnabled": true,
    "scheme": "smartgarden"
  }
}
